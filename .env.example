# ===========================================================================
# Backstage — environment
# ===========================================================================
#
# Copy this file to `.env` in the project root and fill in the two values from
# your Supabase project. `.env` is gitignored; this example is not.
#
# Full walkthrough, including the Google Cloud side:
#   SUPABASE_GOOGLE_AUTH_SETUP.md
# ===========================================================================


# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → anon / public
# (newer dashboards call this the "publishable" key — same thing)
#
# This key is designed to ship inside client applications. It asserts the
# `anon` role and nothing more, and every table it can reach is behind row
# level security. It is not a secret.
SUPABASE_ANON_KEY=your-anon-key


# ---------------------------------------------------------------------------
# NEVER put the service-role key here.
# ---------------------------------------------------------------------------
#
# SUPABASE_SERVICE_ROLE_KEY bypasses every row level security policy in the
# database. Anything it is given to can read and write every user's data.
# Backstage never uses it, has no code path that reads it, and warns on
# startup if it finds one in the environment.
#
# It belongs on a server you control, or nowhere.


# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# The loopback port the Google OAuth callback is served on. Defaults to 8765.
# If you change it, add the new address to Supabase → Authentication → URL
# Configuration → Redirect URLs, or sign-in will fail with a redirect mismatch.
#
# BACKSTAGE_AUTH_PORT=8765

# Open Chrome DevTools on launch in development.
# OPEN_DEVTOOLS=1
